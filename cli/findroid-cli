#!/usr/bin/env bash
#
# findroid-cli - configure the real, running Findroid+ app on this same
# device from Termux: read/write its actual download settings, browse the
# Jellyfin/Sonarr/Radarr/Seerr libraries, trigger real downloads (by item id
# or by show/movie name) through its own Downloader, and debug-proxy
# requests to Jellyfin/Sonarr/Radarr/Seerr using its own already-stored
# credentials. This CLI only ever talks to the local app - it is not a
# standalone Jellyfin client and does not manage other devices.
#
# Transport: a plain loopback HTTP server the app runs on 127.0.0.1 only
# (see Settings > Local CLI access to enable it and get a token). This is
# the third transport tried for this feature - two prior attempts hit
# real, unfixable-at-the-app-level walls on a real device:
#   1. A Linux abstract-namespace unix socket - SELinux blocks arbitrary
#      app-to-app connections outright (confirmed: EACCES under
#      enforcing, the normal state; works under permissive).
#   2. A ContentProvider invoked via Android's `content call` shell
#      command - works, but that command's *external*-access path needs
#      android.permission.ACCESS_CONTENT_PROVIDERS_EXTERNALLY, a
#      signature-level permission only the shell/root uid can ever hold
#      (confirmed: `pm grant` refuses it even as root).
# Loopback TCP has neither problem - it's ordinary socket I/O gated only
# by the INTERNET permission the app already has - so this needs no root
# and no extra Termux packages beyond curl/jq, which almost every Termux
# install already has.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/findroid-cli"
TOKEN_FILE="${CONFIG_DIR}/local_token"
BASE_URL="${FINDROID_LOCAL_URL:-http://127.0.0.1:48411}"

# Set from --json by main() (never `local` there, so this stays a real global).
JSON_OUTPUT=""

usage() {
  cat <<EOF
Usage: $(basename "$0") [--json] COMMAND [OPTIONS]

Configure the real Findroid+ app running on this device, from Termux.
Enable it in the app first: Settings > Downloads > Local CLI access.

  token set TOKEN                            Save the token copied from Settings
  settings get                               Show the app's real download settings
  settings set KEY=VALUE [KEY=VALUE...]      Change the app's real download settings
  library list                               List the Jellyfin libraries (Movies, TV Shows, ...)
  library browse [PARENT_ID] [--search TERM] Browse a library/folder, or search it
  search TERM                                Search the whole Jellyfin server
  sonarr list                                List Sonarr series
  radarr list                                List Radarr movies
  seerr requests [--take N]                  List Seerr requests
  seerr discover [trending|movies|tv] [--page N]  Browse Seerr discover
  seerr search TERM [--page N]               Search Seerr
  download list                              List the app's real current downloads
  download trigger ITEM_ID [SOURCE_ID]       Trigger a real download by item id
  download NAME [SEASON] [EPISODE] [--all]   Trigger a real download by name, e.g.
                                              download "Rick and Morty" "Season 3"
                                              ("list"/"trigger" are reserved - a show/movie
                                              literally titled that needs "library browse
                                              --search" + "download trigger ITEM_ID" instead)
  debug SERVICE METHOD PATH [BODY_JSON]      Debug request via the app (SERVICE: jellyfin|sonarr|radarr|seerr)

Config (environment variable):
  FINDROID_LOCAL_URL  Override the local control server URL (default: ${BASE_URL})

Options:
  --json      Print the raw {status, body} response as JSON instead of a table
  -h, --help  Show this help
EOF
}

require_deps() {
  local missing=""

  if ! command -v curl >/dev/null 2>&1
  then
    missing="curl"
  fi

  if ! command -v jq >/dev/null 2>&1
  then
    missing="${missing:+${missing}, }jq"
  fi

  if [[ -n "${missing}" ]]
  then
    printf 'Missing required command(s): %s\n' "${missing}" >&2
    return 2
  fi
}

get_token() {
  if [[ -f "${TOKEN_FILE}" ]]
  then
    cat "${TOKEN_FILE}"
  fi
}

# Pretty-aligns tab-separated stdin into columns on a real terminal (like tsvtool) - passed
# through unchanged when stdout is piped/redirected or `column` isn't installed, so scripts get
# real TSV instead of column-padded text.
print_table() {
  if [[ -t 1 ]] && command -v column >/dev/null 2>&1
  then
    column -t -s $'\t'
  else
    cat
  fi
}

# --json mode: prints $1 (a local_request response) verbatim and reports its HTTP status via the
# return code - used instead of check_response's human-readable stderr message.
print_response_json() {
  local response="$1"
  local status

  printf '%s\n' "${response}"
  status=$(jq -r '.status' <<< "${response}")
  [[ "${status}" -ge 200 && "${status}" -lt 300 ]]
}

# Builds a URL-encoded query string from KEY=VALUE pairs (e.g. "?foo=bar&q=a%20b") - pairs with an
# empty VALUE are skipped, so callers can pass every possible param unconditionally. No non-empty
# pairs -> empty string (no leading "?").
build_query() {
  local pairs=()
  local pair key value

  for pair in "$@"
  do
    key="${pair%%=*}"
    value="${pair#*=}"
    if [[ -z "${value}" ]]
    then
      continue
    fi
    pairs+=("${key}=$(jq -rn --arg v "${value}" '$v | @uri')")
  done

  if [[ ${#pairs[@]} -eq 0 ]]
  then
    return
  fi
  local IFS='&'
  printf '?%s' "${pairs[*]}"
}

# Renders a `{status, body: [{id, name, type, ...}]}` local_request response (jellyfin/libraries,
# jellyfin/items, jellyfin/search all share this shape) as a table.
render_items_table() {
  local response="$1"

  {
    printf 'ID\tNAME\tTYPE\tEXTRA\n'
    jq -r '
      .body[] |
      [
        .id,
        .name,
        .type,
        (
          if .type == "season" then "S" + (.seasonNumber | tostring)
          elif .type == "episode" then
            "S" + (.seasonNumber | tostring) + "E" + (.episodeNumber | tostring) + " (" + .seriesName + ")"
          elif .tmdbId then "tmdb:" + (.tmdbId | tostring)
          else "-"
          end
        )
      ] | @tsv
    ' <<< "${response}"
  } | print_table
}

# Renders a Seerr `{status, body: {results: [...]}}` response (search/discover share this shape).
render_seerr_search_table() {
  local response="$1"

  {
    printf 'TMDB_ID\tTYPE\tTITLE\n'
    jq -r '.body.results[] | [.id, .mediaType, (.title // .name // "-")] | @tsv' <<< "${response}"
  } | print_table
}

cmd_token_set() {
  local token="${1:-}"

  if [[ -z "${token}" ]]
  then
    printf 'token set requires the token value (copy it from Settings > Local CLI access)\n' >&2
    return 2
  fi

  mkdir -p "${CONFIG_DIR}"
  printf '%s' "${token}" > "${TOKEN_FILE}"
  chmod 600 "${TOKEN_FILE}"

  if [[ -n "${JSON_OUTPUT}" ]]
  then
    jq -n --arg path "${TOKEN_FILE}" '{saved: true, path: $path}'
  else
    printf 'Token saved to %s\n' "${TOKEN_FILE}"
  fi
}

# Sends an authenticated request to the app's local control server and prints
# `{"status": <int>, "body": <json-or-null>}`. $1 = method, $2 = path, $3 = body JSON (optional).
local_request() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local token response http_status body_out

  token=$(get_token)
  if [[ -z "${token}" ]]
  then
    printf 'No local control token configured.\n' >&2
    printf 'Copy it from Findroid+ > Settings > Local CLI access, then:\n' >&2
    printf '  %s token set YOUR_TOKEN\n' "$(basename "$0")" >&2
    return 2
  fi

  local curl_args=(-sS -X "${method}" -H "Authorization: Bearer ${token}" -w '\n%{http_code}')
  if [[ -n "${body}" ]]
  then
    curl_args+=(-H "Content-Type: application/json" -d "${body}")
  fi

  if ! response=$(curl "${curl_args[@]}" "${BASE_URL}${path}")
  then
    printf 'No response from Findroid+ local control (is it enabled? URL: %s)\n' "${BASE_URL}${path}" >&2
    return 1
  fi
  http_status="${response##*$'\n'}"
  body_out="${response%$'\n'*}"

  jq -n --argjson status "${http_status}" --argjson body "${body_out:-null}" '{status: $status, body: $body}'
}

# Prints an error and fails if $1 (a local_request response) is a non-2xx status - shared by
# every command except `debug`, which wants to show non-2xx proxied responses too rather than
# treating them as a CLI-level failure.
check_response() {
  local response="$1"
  local status

  status=$(jq -r '.status' <<< "${response}")
  if [[ "${status}" -lt 200 || "${status}" -ge 300 ]]
  then
    printf 'Request failed (HTTP %s): %s\n' \
      "${status}" "$(jq -r '.body.error // "unknown error"' <<< "${response}")" >&2
    return 1
  fi
}

cmd_settings_get() {
  local response

  response=$(local_request "GET" "/settings/downloads")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'KEY\tVALUE\n'
    jq -r '.body | to_entries[] | [.key, .value] | @tsv' <<< "${response}"
  } | print_table
}

# Each KEY=VALUE's value is type-inferred (true/false -> boolean, digits -> number, else string) -
# the app resolves unknown keys as no-ops rather than failing the whole patch, so a newer CLI
# talking to an older app degrades gracefully.
cmd_settings_set() {
  if [[ $# -eq 0 ]]
  then
    printf 'settings set requires at least one KEY=VALUE pair\n' >&2
    return 2
  fi

  local patch="{}"
  local pair key value
  for pair in "$@"
  do
    if [[ "${pair}" != *=* ]]
    then
      printf 'Invalid KEY=VALUE pair: %s\n' "${pair}" >&2
      return 2
    fi
    key="${pair%%=*}"
    value="${pair#*=}"
    patch=$(
      jq -c --arg k "${key}" --arg v "${value}" '
        .[$k] = (
          if $v == "true" then true
          elif $v == "false" then false
          elif ($v | test("^-?[0-9]+$")) then ($v | tonumber)
          else $v
          end
        )
      ' <<< "${patch}"
    )
  done

  local response
  response=$(local_request "PATCH" "/settings/downloads" "${patch}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'KEY\tVALUE\n'
    jq -r '.body | to_entries[] | [.key, .value] | @tsv' <<< "${response}"
  } | print_table
}

cmd_library_list() {
  local response

  response=$(local_request "GET" "/jellyfin/libraries")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_items_table "${response}"
}

cmd_library_browse() {
  local parent_id="" search=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --search)
        search="${2:-}"
        shift 2
        ;;
      *)
        parent_id="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${parent_id}" && -z "${search}" ]]
  then
    printf 'library browse requires a PARENT_ID and/or --search TERM\n' >&2
    return 2
  fi

  local response
  response=$(local_request "GET" "/jellyfin/items$(build_query "parentId=${parent_id}" "search=${search}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_items_table "${response}"
}

cmd_search() {
  local query="${1:-}"

  if [[ -z "${query}" ]]
  then
    printf 'search requires a term\n' >&2
    return 2
  fi

  local response
  response=$(local_request "GET" "/jellyfin/search$(build_query "q=${query}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_items_table "${response}"
}

cmd_sonarr_list() {
  local response

  response=$(local_request "GET" "/sonarr/series")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ID\tTITLE\tTVDB_ID\tTMDB_ID\n'
    jq -r '.body[] | [.id, .title, .tvdbId, .tmdbId] | @tsv' <<< "${response}"
  } | print_table
}

cmd_radarr_list() {
  local response

  response=$(local_request "GET" "/radarr/movies")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ID\tTITLE\tTMDB_ID\n'
    jq -r '.body[] | [.id, .title, .tmdbId] | @tsv' <<< "${response}"
  } | print_table
}

cmd_seerr_requests() {
  local take=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --take)
        take="${2:-}"
        shift 2
        ;;
      *)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  local response
  response=$(local_request "GET" "/seerr/requests$(build_query "take=${take}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ID\tSTATUS\tTYPE\tTMDB_ID\n'
    jq -r '.body.results[] | [.id, .status, .type, .media.tmdbId] | @tsv' <<< "${response}"
  } | print_table
}

cmd_seerr_discover() {
  local path="trending" page=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --page)
        page="${2:-}"
        shift 2
        ;;
      trending|movies|tv)
        path="$1"
        shift
        ;;
      *)
        printf 'Unknown discover category: %s (expected trending|movies|tv)\n' "$1" >&2
        return 2
        ;;
    esac
  done

  local response
  response=$(local_request "GET" "/seerr/discover/${path}$(build_query "page=${page}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_seerr_search_table "${response}"
}

cmd_seerr_search() {
  local query="" page=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --page)
        page="${2:-}"
        shift 2
        ;;
      *)
        query="$1"
        shift
        ;;
    esac
  done

  if [[ -z "${query}" ]]
  then
    printf 'seerr search requires a term\n' >&2
    return 2
  fi

  local response
  response=$(local_request "GET" "/seerr/search$(build_query "q=${query}" "page=${page}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_seerr_search_table "${response}"
}

cmd_download_list() {
  local response

  response=$(local_request "GET" "/downloads")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ITEM_ID\tNAME\tSOURCE\tSIZE_MIB\tDOWNLOAD_ID\n'
    jq -r '
      .body[] as $item |
      if ($item.sources | length) == 0 then
        [$item.itemId, $item.name, "-", "-", "-"] | @tsv
      else
        $item.sources[] |
        [
          $item.itemId,
          $item.name,
          .name,
          (((.sizeBytes / 1048576 * 10 | round) / 10) | tostring),
          (.downloadId // "-" | tostring)
        ] | @tsv
      end
    ' <<< "${response}"
  } | print_table
}

cmd_download_trigger() {
  local item_id="${1:-}"
  local source_id="${2:-}"

  if [[ -z "${item_id}" ]]
  then
    printf 'download trigger requires an item id\n' >&2
    return 2
  fi

  local body
  if [[ -n "${source_id}" ]]
  then
    body=$(jq -n --arg itemId "${item_id}" --arg sourceId "${source_id}" '{itemId: $itemId, sourceId: $sourceId}')
  else
    body=$(jq -n --arg itemId "${item_id}" '{itemId: $itemId}')
  fi

  local response
  response=$(local_request "POST" "/downloads/trigger" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'DOWNLOAD_ID\n'
    jq -r '[.body.downloadId] | @tsv' <<< "${response}"
  } | print_table
}

# findroid-cli download NAME [SEASON] [EPISODE] [--all] - resolves a movie/show by name (and,
# for a show, a season/episode by number or name) and triggers the matching download(s). A bare
# show name with no season needs --all, so a typo/too-broad match can't silently kick off
# downloading an entire series.
cmd_download_by_name() {
  local positional=() all="false" arg

  for arg in "$@"
  do
    if [[ "${arg}" == "--all" ]]
    then
      all="true"
    else
      positional+=("${arg}")
    fi
  done

  local name="${positional[0]:-}"
  local season="${positional[1]:-}"
  local episode="${positional[2]:-}"

  if [[ -z "${name}" ]]
  then
    printf 'download requires a show/movie name (or "download list" / "download trigger ITEM_ID")\n' >&2
    return 2
  fi

  local body
  body=$(
    jq -n \
      --arg query "${name}" \
      --arg season "${season}" \
      --arg episode "${episode}" \
      --argjson all "${all}" \
      '{query: $query, all: $all} +
       (if $season != "" then {season: $season} else {} end) +
       (if $episode != "" then {episode: $episode} else {} end)'
  )

  local response
  response=$(local_request "POST" "/downloads/trigger-by-name" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ITEM_ID\tNAME\tDOWNLOAD_ID\n'
    jq -r '.body.triggered[] | [.itemId, .name, (.downloadId // .error // "-")] | @tsv' <<< "${response}"
  } | print_table
}

# Unlike the other commands, a non-2xx response here is still useful output (e.g. Sonarr's own
# 404) rather than a CLI-level failure, so this prints the status and whatever body came back
# instead of calling check_response.
cmd_debug() {
  local service="${1:-}"
  local method="${2:-GET}"
  local path="${3:-}"
  local body_json="${4:-null}"

  if [[ -z "${service}" || -z "${path}" ]]
  then
    printf 'debug requires SERVICE and PATH (jellyfin|sonarr|radarr|seerr)\n' >&2
    return 2
  fi

  local body
  body=$(
    jq -n \
      --arg service "${service}" \
      --arg method "${method}" \
      --arg path "${path}" \
      --argjson requestBody "${body_json}" \
      '{service: $service, method: $method, path: $path, body: $requestBody}'
  )

  local response status
  response=$(local_request "POST" "/debug/proxy" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    printf '%s\n' "${response}"
    return
  fi
  status=$(jq -r '.status' <<< "${response}")
  printf 'HTTP %s\n' "${status}" >&2
  jq -r '.body.body // .body.error // empty' <<< "${response}"
}

main() {
  local args=()
  local arg

  for arg in "$@"
  do
    if [[ "${arg}" == "--json" ]]
    then
      JSON_OUTPUT=1
    else
      args+=("${arg}")
    fi
  done
  set -- "${args[@]}"

  if [[ -z "${1:-}" ]]
  then
    usage >&2
    return 2
  fi

  case "$1" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  require_deps

  case "$1" in
    token)
      shift
      case "${1:-}" in
        set)
          shift
          cmd_token_set "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    settings)
      shift
      case "${1:-}" in
        get)
          shift
          cmd_settings_get "$@"
          ;;
        set)
          shift
          cmd_settings_set "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    library)
      shift
      case "${1:-}" in
        list)
          shift
          cmd_library_list "$@"
          ;;
        browse)
          shift
          cmd_library_browse "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    search)
      shift
      cmd_search "$@"
      ;;
    sonarr)
      shift
      case "${1:-}" in
        list)
          shift
          cmd_sonarr_list "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    radarr)
      shift
      case "${1:-}" in
        list)
          shift
          cmd_radarr_list "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    seerr)
      shift
      case "${1:-}" in
        requests)
          shift
          cmd_seerr_requests "$@"
          ;;
        discover)
          shift
          cmd_seerr_discover "$@"
          ;;
        search)
          shift
          cmd_seerr_search "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    download)
      shift
      case "${1:-}" in
        list)
          shift
          cmd_download_list "$@"
          ;;
        trigger)
          shift
          cmd_download_trigger "$@"
          ;;
        "")
          usage >&2
          return 2
          ;;
        *)
          cmd_download_by_name "$@"
          ;;
      esac
      ;;
    debug)
      shift
      cmd_debug "$@"
      ;;
    *)
      printf 'Unknown command: %s\n' "$1" >&2
      usage >&2
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  main "$@"
fi

# vim: set ft=sh et ts=2 sw=2 :
