#!/usr/bin/env bash
#
# findroid-cli - manage Findroid+ downloads from Termux, locally and on
# other devices logged into the same Jellyfin account.
#
# Remote commands reuse the exact wire format/transport FINDROID-44 built
# for the app itself: a queue of commands and a device heartbeat registry,
# both stored as JSON strings inside the shared Jellyfin account's
# DisplayPreferences "findroidplus-remoteconfig" bucket. This CLI is just
# another peer in that same mesh - it has no Room database or Downloader of
# its own, so a command pushed *to* this CLI's device id is never actually
# applied by anything (it just dead-letters after the app's own 30-day TTL,
# the same as pushing to a device that's permanently offline).
#
# Local commands are a separate, simpler "download the file yourself"
# path - they do not read the real Findroid+ Android app's own downloads,
# which live in that app's private Room database and are not reachable
# from Termux without the app itself exposing a control surface (a bigger,
# separate feature - see TODO.md FINDROID-45).

set -euo pipefail

BUCKET_ID="findroidplus-remoteconfig"
CLIENT="FindroidPlusRemoteConfig"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/findroid-cli"
CONFIG_FILE="${CONFIG_DIR}/config"
DEVICE_ID_FILE="${CONFIG_DIR}/device_id"
SERVER_ID_CACHE_FILE="${CONFIG_DIR}/server_id"

usage() {
  cat <<EOF
Usage: $(basename "$0") COMMAND [OPTIONS]

Manage Findroid+ downloads locally and on other devices logged into the
same Jellyfin account, from Termux.

Config (environment variables, or sourced from ${CONFIG_FILE}):
  FINDROID_SERVER        Jellyfin server base URL (e.g. https://jellyfin.example.com)
  FINDROID_TOKEN         Jellyfin API access token
  FINDROID_USER_ID       Jellyfin user id
  FINDROID_DEVICE_NAME   Display name for this CLI as a device (default: device model/hostname)
  FINDROID_DOWNLOAD_DIR  Local download directory (default: \$HOME/findroid-downloads)

Remote (cross-device, via the shared Jellyfin account):
  devices                                    List other devices and their active auto-download rules
  rule push --target ID --series ID [--seasons ID1,ID2] [--future] [--only-new] [--unwatched] [--name NAME]
                                              Push/replace an auto-download rule on another device
  rule remove --target ID --series ID [--name NAME]
                                              Clear an auto-download rule on another device
  download push --target ID --item ID [--source ID] [--name NAME]
                                              Push a one-off episode/movie download to another device
  pending list                               List this CLI's own not-yet-applied pushes
  pending cancel ID                          Cancel a still-pending push

Local (this Termux install only):
  download get --item ID [--source ID] [--output DIR]
                                              Download an item straight to local storage
  download list                              List locally downloaded files
  download rm FILE                           Remove a locally downloaded file

Options:
  -h, --help  Show this help
EOF
}

require_deps() {
  local missing=""

  if ! command -v curl >/dev/null 2>&1
  then
    missing="curl"
  fi

  if ! command -v jq >/dev/null 2>&1
  then
    missing="${missing:+${missing}, }jq"
  fi

  if [[ -n "${missing}" ]]
  then
    printf 'Missing required command(s): %s\n' "${missing}" >&2
    return 2
  fi
}

load_config() {
  if [[ -f "${CONFIG_FILE}" ]]
  then
    # shellcheck source=/dev/null
    source "${CONFIG_FILE}"
  fi

  if [[ -z "${FINDROID_SERVER:-}" || -z "${FINDROID_TOKEN:-}" || -z "${FINDROID_USER_ID:-}" ]]
  then
    printf 'Missing configuration.\n' >&2
    printf 'Set FINDROID_SERVER, FINDROID_TOKEN and FINDROID_USER_ID via environment\n' >&2
    printf 'variables, or write them to %s\n' "${CONFIG_FILE}" >&2
    return 2
  fi

  FINDROID_SERVER="${FINDROID_SERVER%/}"
}

new_uuid() {
  if [[ -r /proc/sys/kernel/random/uuid ]]
  then
    cat /proc/sys/kernel/random/uuid
  else
    printf '%s-%s' "$(date +%s%N)" "$$"
  fi
}

get_or_create_device_id() {
  mkdir -p "${CONFIG_DIR}"

  if [[ -f "${DEVICE_ID_FILE}" ]]
  then
    cat "${DEVICE_ID_FILE}"
    return 0
  fi

  local id
  id=$(new_uuid)
  printf '%s' "${id}" > "${DEVICE_ID_FILE}"
  printf '%s' "${id}"
}

get_device_name() {
  if [[ -n "${FINDROID_DEVICE_NAME:-}" ]]
  then
    printf '%s' "${FINDROID_DEVICE_NAME}"
    return 0
  fi

  if command -v getprop >/dev/null 2>&1
  then
    getprop ro.product.model 2>/dev/null && return 0
  fi

  hostname
}

bool_json() {
  if [[ -n "${1:-}" ]]
  then
    printf 'true'
  else
    printf 'false'
  fi
}

api_get() {
  local path="$1"

  curl -fsS -H "X-Emby-Token: ${FINDROID_TOKEN}" "${FINDROID_SERVER}${path}"
}

api_post_json() {
  local path="$1"
  local body="$2"

  curl -fsS -X POST \
    -H "X-Emby-Token: ${FINDROID_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "${body}" \
    "${FINDROID_SERVER}${path}" \
    > /dev/null
}

get_server_id() {
  mkdir -p "${CONFIG_DIR}"

  if [[ -f "${SERVER_ID_CACHE_FILE}" ]]
  then
    cat "${SERVER_ID_CACHE_FILE}"
    return 0
  fi

  local id
  id=$(api_get "/System/Info" | jq -r '.Id // empty')
  if [[ -z "${id}" ]]
  then
    printf 'Failed to resolve the Jellyfin server id\n' >&2
    return 1
  fi

  printf '%s' "${id}" > "${SERVER_ID_CACHE_FILE}"
  printf '%s' "${id}"
}

resolve_item_name() {
  local item_id="$1"

  api_get "/Users/${FINDROID_USER_ID}/Items/${item_id}" | jq -r '.Name // empty'
}

resolve_first_source_id() {
  local item_id="$1"

  api_get "/Users/${FINDROID_USER_ID}/Items/${item_id}?Fields=MediaSources" |
    jq -r '.MediaSources[0].Id // empty'
}

fetch_bucket() {
  api_get "/DisplayPreferences/${BUCKET_ID}?userId=${FINDROID_USER_ID}&client=${CLIENT}"
}

write_bucket() {
  local bucket_json="$1"

  api_post_json "/DisplayPreferences/${BUCKET_ID}?userId=${FINDROID_USER_ID}&client=${CLIENT}" "${bucket_json}"
}

# CustomPrefs is a flat Map<String,String> - "pending"/"devices" are themselves JSON strings that
# need a second decode. Missing/empty defaults to an empty array.
decode_custom_pref_array() {
  local bucket="$1"
  local key="$2"
  local raw

  raw=$(jq -r --arg k "${key}" '.CustomPrefs[$k] // empty' <<< "${bucket}")
  if [[ -z "${raw}" ]]
  then
    printf '[]'
  else
    printf '%s' "${raw}"
  fi
}

# Re-fetches immediately before merging, same "accepted tradeoff" as the app's own
# RemoteConfigRepositoryImpl: no real CAS against the server, just a best-effort narrow window -
# fine for this low-frequency, manual, personal-use feature.
#
# Also refreshes this CLI's own heartbeat entry in the same write, so it shows up as a real
# device (pushable target, visible in the app's Remote Devices screen) to anyone else on the
# account - folded into the same round trip as the actual push rather than a separate one, since
# every caller of enqueue_command is already about to write the bucket anyway. activeRules is
# always empty here: the CLI has no Room database of its own to run auto-download rules against.
enqueue_command() {
  local command_json="$1"
  local bucket pending new_pending devices new_devices new_bucket this_id name now

  this_id=$(get_or_create_device_id)
  name=$(get_device_name)
  now=$(date +%s%3N)

  bucket=$(fetch_bucket)

  pending=$(decode_custom_pref_array "${bucket}" "pending")
  new_pending=$(jq -c --argjson cmd "${command_json}" '. + [$cmd]' <<< "${pending}")

  devices=$(decode_custom_pref_array "${bucket}" "devices")
  new_devices=$(
    jq -c --arg id "${this_id}" --arg name "${name}" --argjson now "${now}" '
      map(select(.id != $id)) + [{id: $id, name: $name, lastSeenMillis: $now, activeRules: []}]
    ' <<< "${devices}"
  )

  new_bucket=$(
    jq --arg pending "${new_pending}" --arg devices "${new_devices}" '
      .CustomPrefs.pending = $pending | .CustomPrefs.devices = $devices
    ' <<< "${bucket}"
  )
  write_bucket "${new_bucket}"
}

# Mirrors RemoteConfigCommand.ReconcileRules exactly (data/.../models/AutoDownloadRemoteCommand.kt)
# - an empty seasons array with also_future unset clears the rule entirely, same as the app's own
# pushRemoveRule.
build_reconcile_command() {
  local target="$1"
  local series="$2"
  local seasons_json="$3"
  local also_future="$4"
  local only_new="$5"
  local only_unwatched="$6"
  local name="$7"
  local id origin now server_id

  id=$(new_uuid)
  origin=$(get_or_create_device_id)
  now=$(date +%s%3N)
  server_id=$(get_server_id)

  jq -n \
    --arg id "${id}" \
    --arg target "${target}" \
    --arg origin "${origin}" \
    --argjson createdAt "${now}" \
    --arg server "${server_id}" \
    --arg name "${name}" \
    --arg userId "${FINDROID_USER_ID}" \
    --arg seriesId "${series}" \
    --argjson seasonIds "${seasons_json}" \
    --argjson alsoFutureSeasons "$(bool_json "${also_future}")" \
    --argjson onlyNewEpisodes "$(bool_json "${only_new}")" \
    --argjson onlyUnwatched "$(bool_json "${only_unwatched}")" \
    '{
      type: "reconcile_rules",
      id: $id,
      targetDeviceId: $target,
      originDeviceId: $origin,
      createdAt: $createdAt,
      serverId: $server,
      displayName: $name,
      userId: $userId,
      seriesId: $seriesId,
      seasonIds: $seasonIds,
      alsoFutureSeasons: $alsoFutureSeasons,
      onlyNewEpisodes: $onlyNewEpisodes,
      onlyUnwatched: $onlyUnwatched
    }'
}

# Mirrors RemoteConfigCommand.DownloadItem exactly - no storage-index field, the target always
# resolves its own preferred storage at apply time.
build_download_item_command() {
  local target="$1"
  local item_id="$2"
  local source_id="$3"
  local name="$4"
  local id origin now server_id

  id=$(new_uuid)
  origin=$(get_or_create_device_id)
  now=$(date +%s%3N)
  server_id=$(get_server_id)

  jq -n \
    --arg id "${id}" \
    --arg target "${target}" \
    --arg origin "${origin}" \
    --argjson createdAt "${now}" \
    --arg server "${server_id}" \
    --arg name "${name}" \
    --arg itemId "${item_id}" \
    --arg sourceId "${source_id}" \
    '{
      type: "download_item",
      id: $id,
      targetDeviceId: $target,
      originDeviceId: $origin,
      createdAt: $createdAt,
      serverId: $server,
      displayName: $name,
      itemId: $itemId,
      sourceId: $sourceId
    }'
}

csv_to_json_array() {
  local csv="$1"

  if [[ -z "${csv}" ]]
  then
    printf '[]'
    return 0
  fi

  jq -c -R 'split(",")' <<< "${csv}"
}

download_dir() {
  printf '%s' "${FINDROID_DOWNLOAD_DIR:-${HOME}/findroid-downloads}"
}

cmd_devices() {
  local bucket devices

  bucket=$(fetch_bucket)
  devices=$(decode_custom_pref_array "${bucket}" "devices")

  jq -r '
    if length == 0 then
      "No other devices seen yet."
    else
      map(
        "\(.name)  (id: \(.id))\n" +
        "  last seen: \(.lastSeenMillis / 1000 | todate)\n" +
        (
          if (.activeRules | length) == 0 then
            "  no active rules"
          else
            (.activeRules | map(
              "  - " + .showName +
              " (" + (.seasonCount | tostring) + " season(s)" +
              (if .alsoFutureSeasons then ", +future seasons" else "" end) +
              ")  [series: " + .seriesId + "]"
            ) | join("\n"))
          end
        )
      ) | join("\n\n")
    end
  ' <<< "${devices}"
}

cmd_rule_push() {
  local target=""
  local series=""
  local seasons=""
  local also_future=""
  local only_new=""
  local only_unwatched=""
  local name=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --target)
        target="$2"
        shift 2
        ;;
      --series)
        series="$2"
        shift 2
        ;;
      --seasons)
        seasons="$2"
        shift 2
        ;;
      --future)
        also_future=1
        shift
        ;;
      --only-new)
        only_new=1
        shift
        ;;
      --unwatched)
        only_unwatched=1
        shift
        ;;
      --name)
        name="$2"
        shift 2
        ;;
      *)
        printf 'rule push: unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${target}" || -z "${series}" ]]
  then
    printf 'rule push requires --target and --series\n' >&2
    return 2
  fi

  if [[ -z "${name}" ]]
  then
    name=$(resolve_item_name "${series}")
  fi

  local seasons_json command
  seasons_json=$(csv_to_json_array "${seasons}")
  command=$(
    build_reconcile_command \
      "${target}" "${series}" "${seasons_json}" \
      "${also_future}" "${only_new}" "${only_unwatched}" "${name}"
  )
  enqueue_command "${command}"
  printf 'Rule push queued for %s (%s)\n' "${target}" "${name:-${series}}"
}

cmd_rule_remove() {
  local target=""
  local series=""
  local name=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --target)
        target="$2"
        shift 2
        ;;
      --series)
        series="$2"
        shift 2
        ;;
      --name)
        name="$2"
        shift 2
        ;;
      *)
        printf 'rule remove: unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${target}" || -z "${series}" ]]
  then
    printf 'rule remove requires --target and --series\n' >&2
    return 2
  fi

  if [[ -z "${name}" ]]
  then
    name=$(resolve_item_name "${series}")
  fi

  local command
  command=$(build_reconcile_command "${target}" "${series}" "[]" "" "" "" "${name}")
  enqueue_command "${command}"
  printf 'Rule removal queued for %s (%s)\n' "${target}" "${name:-${series}}"
}

cmd_download_push() {
  local target=""
  local item_id=""
  local source_id=""
  local name=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --target)
        target="$2"
        shift 2
        ;;
      --item)
        item_id="$2"
        shift 2
        ;;
      --source)
        source_id="$2"
        shift 2
        ;;
      --name)
        name="$2"
        shift 2
        ;;
      *)
        printf 'download push: unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${target}" || -z "${item_id}" ]]
  then
    printf 'download push requires --target and --item\n' >&2
    return 2
  fi

  if [[ -z "${source_id}" ]]
  then
    source_id=$(resolve_first_source_id "${item_id}")
  fi

  if [[ -z "${name}" ]]
  then
    name=$(resolve_item_name "${item_id}")
  fi

  local command
  command=$(build_download_item_command "${target}" "${item_id}" "${source_id}" "${name}")
  enqueue_command "${command}"
  printf 'Download push queued for %s (%s)\n' "${target}" "${name:-${item_id}}"
}

cmd_pending_list() {
  local this_id bucket pending

  this_id=$(get_or_create_device_id)
  bucket=$(fetch_bucket)
  pending=$(decode_custom_pref_array "${bucket}" "pending")

  jq -r --arg id "${this_id}" '
    map(select(.originDeviceId == $id)) |
    if length == 0 then
      "No pending pushes from this device."
    else
      map("\(.id)  \(.displayName)  ->  \(.targetDeviceId)  [\(.type)]") | join("\n")
    end
  ' <<< "${pending}"
}

cmd_pending_cancel() {
  local command_id="${1:-}"

  if [[ -z "${command_id}" ]]
  then
    printf 'pending cancel requires a command id\n' >&2
    return 2
  fi

  local bucket pending new_pending new_bucket

  bucket=$(fetch_bucket)
  pending=$(decode_custom_pref_array "${bucket}" "pending")
  new_pending=$(jq -c --arg id "${command_id}" 'map(select(.id != $id))' <<< "${pending}")
  new_bucket=$(jq --arg pending "${new_pending}" '.CustomPrefs.pending = $pending' <<< "${bucket}")
  write_bucket "${new_bucket}"
  printf 'Canceled %s\n' "${command_id}"
}

cmd_download_get() {
  local item_id=""
  local source_id=""
  local output_dir
  output_dir=$(download_dir)

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --item)
        item_id="$2"
        shift 2
        ;;
      --source)
        source_id="$2"
        shift 2
        ;;
      --output)
        output_dir="$2"
        shift 2
        ;;
      *)
        printf 'download get: unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  if [[ -z "${item_id}" ]]
  then
    printf 'download get requires --item\n' >&2
    return 2
  fi

  mkdir -p "${output_dir}"

  local name url
  name=$(resolve_item_name "${item_id}")
  url="${FINDROID_SERVER}/Items/${item_id}/Download?api_key=${FINDROID_TOKEN}"
  if [[ -n "${source_id}" ]]
  then
    url="${url}&mediaSourceId=${source_id}"
  fi

  printf 'Downloading "%s" into %s\n' "${name:-${item_id}}" "${output_dir}"
  (
    cd "${output_dir}" &&
      curl -fSL --progress-bar -J -O "${url}"
  )
}

cmd_download_list() {
  local dir
  dir=$(download_dir)

  if [[ ! -d "${dir}" ]]
  then
    printf 'No local downloads yet (%s does not exist)\n' "${dir}"
    return 0
  fi

  ls -lh "${dir}"
}

cmd_download_rm() {
  local file="${1:-}"
  local dir
  dir=$(download_dir)

  if [[ -z "${file}" ]]
  then
    printf 'download rm requires a filename (see: download list)\n' >&2
    return 2
  fi

  rm -v -- "${dir}/${file}"
}

main() {
  if [[ -z "${1:-}" ]]
  then
    usage >&2
    return 2
  fi

  case "$1" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  require_deps
  load_config

  case "$1" in
    devices)
      shift
      cmd_devices "$@"
      ;;
    rule)
      shift
      case "${1:-}" in
        push)
          shift
          cmd_rule_push "$@"
          ;;
        remove)
          shift
          cmd_rule_remove "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    download)
      shift
      case "${1:-}" in
        push)
          shift
          cmd_download_push "$@"
          ;;
        get)
          shift
          cmd_download_get "$@"
          ;;
        list)
          shift
          cmd_download_list "$@"
          ;;
        rm)
          shift
          cmd_download_rm "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    pending)
      shift
      case "${1:-}" in
        list)
          shift
          cmd_pending_list "$@"
          ;;
        cancel)
          shift
          cmd_pending_cancel "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    *)
      printf 'Unknown command: %s\n' "$1" >&2
      usage >&2
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  main "$@"
fi

