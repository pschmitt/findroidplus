# findroid-cli download list [--active|--completed] - one row per downloaded source (movies and,
# unlike the app's own getDownloads() alone, every downloaded episode too). --active shows only
# in-progress transfers (with live percent/speed/eta); --completed shows only finished ones;
# neither flag shows both.
cmd_download_list() {
  local status=""

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --active)
        status="downloading"
        shift
        ;;
      --completed)
        status="completed"
        shift
        ;;
      *)
        printf 'Unknown option: %s\n' "$1" >&2
        return 2
        ;;
    esac
  done

  local response
  response=$(local_request "GET" "/downloads$(build_query "status=${status}")")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'ITEM_ID\tNAME\tSTATUS\tPROGRESS\tSIZE_MIB\tDOWNLOAD_ID\n'
    jq -r '
      .body[] |
      [
        .itemId,
        (if .seriesName then "\(.seriesName) - \(.name) (S\(.seasonNumber)E\(.episodeNumber))" else .name end),
        .status,
        (if .status == "downloading" then "\(.percent)%" else "-" end),
        ((.sizeBytes / 1048576 * 10 | round) / 10 | tostring),
        (.downloadId // "-")
      ] | @tsv
    ' <<< "${response}"
  } | print_table
}

# findroid-cli download cancel DOWNLOAD_ID - stops an in-progress transfer (from "download list"'s
# DOWNLOAD_ID column) and cleans up its partial file, same as the app's own Downloads screen.
cmd_download_cancel() {
  local download_id="${1:-}"

  if [[ -z "${download_id}" ]]
  then
    printf 'download cancel requires a DOWNLOAD_ID (from "download list")\n' >&2
    return 2
  fi

  local body
  body=$(jq -n --arg downloadId "${download_id}" '{downloadId: $downloadId}')

  local response
  response=$(local_request "POST" "/downloads/cancel" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Cancelled download %s\n' "${download_id}"
}

# findroid-cli download remove ITEM_ID [ITEM_ID...] - deletes an already-downloaded item (from
# "download list"'s ITEM_ID column), same cascade as the app's own Downloads screen delete. For an
# in-progress download, use "download cancel" instead.
cmd_download_remove() {
  if [[ $# -eq 0 ]]
  then
    printf 'download remove requires at least one ITEM_ID (from "download list")\n' >&2
    return 2
  fi

  local body
  if [[ $# -eq 1 ]]
  then
    body=$(jq -n --arg itemId "$1" '{itemId: $itemId}')
  else
    body=$(jq -n --args '{itemIds: $ARGS.positional}' -- "$@")
  fi

  local response
  response=$(local_request "POST" "/downloads/remove" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Removed %s item(s)\n' "$(jq -r '.body.removed' <<< "${response}")"
}

cmd_download_trigger() {
  local item_id="${1:-}"
  local source_id="${2:-}"

  if [[ -z "${item_id}" ]]
  then
    printf 'download trigger requires an item id\n' >&2
    return 2
  fi

  local body
  if [[ -n "${source_id}" ]]
  then
    body=$(jq -n --arg itemId "${item_id}" --arg sourceId "${source_id}" '{itemId: $itemId, sourceId: $sourceId}')
  else
    body=$(jq -n --arg itemId "${item_id}" '{itemId: $itemId}')
  fi

  local response
  response=$(local_request "POST" "/downloads/trigger" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  {
    printf 'DOWNLOAD_ID\n'
    jq -r '[.body.downloadId] | @tsv' <<< "${response}"
  } | print_table
}

# findroid-cli download NAME [SEASON] [EPISODE] [--all] - resolves a movie/show by name (and,
# for a show, a season/episode by number or name) and triggers the matching download(s). A bare
# show name with no season needs --all, so a typo/too-broad match can't silently kick off
# downloading an entire series.
cmd_download_by_name() {
  local positional=() all="false" arg

  for arg in "$@"
  do
    if [[ "${arg}" == "--all" ]]
    then
      all="true"
    else
      positional+=("${arg}")
    fi
  done

  local name="${positional[0]:-}"

  if [[ -z "${name}" ]]
  then
    printf 'download requires a show/movie/episode name or item id (or "download list")\n' >&2
    return 2
  fi

  # A bare item id (copied from "library browse"/"search" output) works here too - forward
  # straight to the id-based trigger instead of searching for a literal UUID as if it were a title.
  if [[ "${name}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
  then
    cmd_download_trigger "${positional[@]}"
    return
  fi

  local season="${positional[1]:-}"
  local episode="${positional[2]:-}"

  local body
  body=$(
    jq -n \
      --arg query "${name}" \
      --arg season "${season}" \
      --arg episode "${episode}" \
      --argjson all "${all}" \
      '{query: $query, all: $all} +
       (if $season != "" then {season: $season} else {} end) +
       (if $episode != "" then {episode: $episode} else {} end)'
  )

  local response
  response=$(local_request "POST" "/downloads/trigger-by-name" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi

  # Some episodes in a batch can fail (e.g. no media source) while others succeed - when the
  # response carries a per-item "triggered" array at all, show every row's own result/error
  # regardless of the overall HTTP status, instead of check_response's blanket "unknown error".
  if jq -e '.body.triggered' <<< "${response}" >/dev/null 2>&1
  then
    local status
    status=$(jq -r '.status' <<< "${response}")
    {
      printf 'ITEM_ID\tNAME\tDOWNLOAD_ID\n'
      jq -r '.body.triggered[] | [.itemId, .name, (.downloadId // .error // "-")] | @tsv' <<< "${response}"
    } | print_table
    [[ "${status}" -ge 200 && "${status}" -lt 300 ]]
  else
    check_response "${response}" || return 1
  fi
}

# Unlike the other commands, a non-2xx response here is still useful output (e.g. Sonarr's own
# 404) rather than a CLI-level failure, so this prints the status and whatever body came back
# instead of calling check_response.
cmd_debug() {
  local service="${1:-}"
  local method="${2:-GET}"
  local path="${3:-}"
  local body_json="${4:-null}"

  if [[ -z "${service}" || -z "${path}" ]]
  then
    printf 'debug requires SERVICE and PATH (jellyfin|sonarr|radarr|seerr)\n' >&2
    return 2
  fi

  local body
  body=$(
    jq -n \
      --arg service "${service}" \
      --arg method "${method}" \
      --arg path "${path}" \
      --argjson requestBody "${body_json}" \
      '{service: $service, method: $method, path: $path, body: $requestBody}'
  )

  local response status
  response=$(local_request "POST" "/debug/proxy" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    printf '%s\n' "${response}"
    return
  fi
  status=$(jq -r '.status' <<< "${response}")
  printf 'HTTP %s\n' "${status}" >&2
  jq -r '.body.body // .body.error // empty' <<< "${response}"
}

# findroid-cli version - always shows this script's own CLI_VERSION, even with no token
# configured or the app unreachable (useful on its own for "am I up to date" checks), then
# attempts GET /info for the running app's own versionName/versionCode/gitRevision. Reaching the
# app failing (no token, app not running/local control disabled) is reported on stderr by
# local_request/check_response themselves, same as every other command - not a hard failure here,
# so the command still exits 0 having shown at least the CLI's own version.
cmd_version() {
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    jq -n --arg cliVersion "${CLI_VERSION}" '{cliVersion: $cliVersion}'
    local response
    if response=$(local_request "GET" "/info")
    then
      print_response_json "${response}"
    fi
    return 0
  fi

  printf 'findroid-cli: %s\n' "${CLI_VERSION}"

  local response
  if ! response=$(local_request "GET" "/info")
  then
    return 0
  fi
  if ! check_response "${response}"
  then
    return 0
  fi
  {
    printf 'KEY\tVALUE\n'
    jq -r '.body | to_entries[] | [.key, .value] | @tsv' <<< "${response}"
  } | print_table
}

# Renders a `{status, body: [{id, seriesName, seasonNumber, ...}]}` local_request response
# (autodownload list/add share this shape) as a table.
render_autodownload_rules_table() {
  local response="$1"

  {
    printf 'ID\tSHOW\tSCOPE\tENABLED\tONLY_NEW\tONLY_UNWATCHED\n'
    jq -r '
      .body[] |
      [
        .id,
        .seriesName,
        (if .seasonNumber then "S" + (.seasonNumber | tostring) else "future seasons" end),
        .enabled,
        .onlyNewEpisodes,
        .onlyUnwatched
      ] | @tsv
    ' <<< "${response}"
  } | print_table
}

# findroid-cli autodownload list - this device's own local auto-download rules (evaluated by its
# own WorkManager), not the app's separate cross-device rule-push feature.
cmd_autodownload_list() {
  local response
  response=$(local_request "GET" "/autodownload/rules")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_autodownload_rules_table "${response}"
}

# findroid-cli autodownload add NAME_OR_ID [--season S[,S...]|--all-seasons|--future-seasons]
#                                [--only-new] [--only-unwatched]
# Adds/replaces this device's local auto-download rule for a show - resolves NAME_OR_ID exactly
# like "download NAME" (a UUID-shaped argument routes straight to seriesId instead of a name
# search). Exactly one of --season/--all-seasons picks which existing seasons are covered;
# --future-seasons additionally (or, with none of the others, exclusively) tracks seasons not
# released yet. Giving none of the three still creates a rule - a future-seasons-only one, same as
# leaving every season unchecked in the app's own "add rule" dialog.
cmd_autodownload_add() {
  local positional=() season="" all_seasons="false" future_seasons="false"
  local only_new="false" only_unwatched="false"

  while [[ -n "${1:-}" ]]
  do
    case "$1" in
      --season)
        season="${2:-}"
        shift 2
        ;;
      --all-seasons)
        all_seasons="true"
        shift
        ;;
      --future-seasons)
        future_seasons="true"
        shift
        ;;
      --only-new)
        only_new="true"
        shift
        ;;
      --only-unwatched)
        only_unwatched="true"
        shift
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  local name="${positional[0]:-}"
  if [[ -z "${name}" ]]
  then
    printf 'autodownload add requires a show name or item id ("library browse"/"search")\n' >&2
    return 2
  fi

  local id_field="query"
  if [[ "${name}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
  then
    id_field="seriesId"
  fi

  local seasons_json="null"
  if [[ -n "${season}" ]]
  then
    seasons_json=$(jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length > 0))' <<< "${season}")
  fi

  local body
  body=$(
    jq -n \
      --arg idField "${id_field}" \
      --arg idValue "${name}" \
      --argjson seasons "${seasons_json}" \
      --argjson all "${all_seasons}" \
      --argjson alsoFutureSeasons "${future_seasons}" \
      --argjson onlyNewEpisodes "${only_new}" \
      --argjson onlyUnwatched "${only_unwatched}" \
      '{($idField): $idValue, all: $all, onlyNewEpisodes: $onlyNewEpisodes, onlyUnwatched: $onlyUnwatched} +
       (if $seasons != null then {seasons: $seasons} else {} end) +
       (if $alsoFutureSeasons then {alsoFutureSeasons: true} else {} end)'
  )

  local response
  response=$(local_request "POST" "/autodownload/rules" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  render_autodownload_rules_table "${response}"
}

# findroid-cli autodownload remove NAME_OR_ID - removes every local auto-download rule for a show
# at once (mirrors the app's own delete action: clears every season/future-seasons row for that
# show, not just one). Use "autodownload remove-id" instead to remove just a single rule row.
cmd_autodownload_remove() {
  local name="${1:-}"

  if [[ -z "${name}" ]]
  then
    printf 'autodownload remove requires a show name or item id ("autodownload list"/"search")\n' >&2
    return 2
  fi

  local id_field="query"
  if [[ "${name}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
  then
    id_field="seriesId"
  fi

  local body
  body=$(jq -n --arg idField "${id_field}" --arg idValue "${name}" '{($idField): $idValue}')

  local response
  response=$(local_request "POST" "/autodownload/rules/remove" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Removed %s rule(s)\n' "$(jq -r '.body.removed' <<< "${response}")"
}

# findroid-cli autodownload remove-id RULE_ID - removes a single rule row by numeric id (from
# "autodownload list"'s ID column), rather than every rule for its show.
cmd_autodownload_remove_id() {
  local rule_id="${1:-}"

  if [[ -z "${rule_id}" ]]
  then
    printf 'autodownload remove-id requires a RULE_ID (from "autodownload list")\n' >&2
    return 2
  fi

  local body
  body=$(jq -n --arg id "${rule_id}" '{id: $id}')

  local response
  response=$(local_request "POST" "/autodownload/rules/remove" "${body}")
  if [[ -n "${JSON_OUTPUT}" ]]
  then
    print_response_json "${response}"
    return
  fi
  check_response "${response}" || return 1
  printf 'Removed rule %s\n' "${rule_id}"
}

main() {
  local args=()
  local arg

  for arg in "$@"
  do
    if [[ "${arg}" == "--json" ]]
    then
      JSON_OUTPUT=1
    else
      args+=("${arg}")
    fi
  done
  set -- "${args[@]}"

  if [[ -z "${1:-}" ]]
  then
    usage >&2
    return 2
  fi

  case "$1" in
    -h|--help)
      usage
      return 0
      ;;
  esac

  require_deps

  case "$1" in
    token)
      shift
      case "${1:-}" in
        set)
          shift
          cmd_token_set "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    settings|cfg)
      shift
      case "${1:-}" in
        get)
          shift
          cmd_settings_get "$@"
          ;;
        set)
          shift
          cmd_settings_set "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    library|lib)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_library_list "$@"
          ;;
        browse|br)
          shift
          cmd_library_browse "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    search)
      shift
      cmd_search "$@"
      ;;
    sonarr)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_sonarr_list "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    radarr)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_radarr_list "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    seerr)
      shift
      case "${1:-}" in
        requests|req)
          shift
          cmd_seerr_requests "$@"
          ;;
        discover|disc)
          shift
          cmd_seerr_discover "$@"
          ;;
        search)
          shift
          cmd_seerr_search "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    download|dl)
      shift
      case "${1:-}" in
        --)
          shift
          cmd_download_by_name "$@"
          ;;
        list|ls)
          shift
          cmd_download_list "$@"
          ;;
        trigger|trig)
          shift
          cmd_download_trigger "$@"
          ;;
        cancel|c)
          shift
          cmd_download_cancel "$@"
          ;;
        remove|rm|del)
          shift
          cmd_download_remove "$@"
          ;;
        "")
          usage >&2
          return 2
          ;;
        *)
          cmd_download_by_name "$@"
          ;;
      esac
      ;;
    debug)
      shift
      cmd_debug "$@"
      ;;
    autodownload|auto)
      shift
      case "${1:-}" in
        list|ls)
          shift
          cmd_autodownload_list "$@"
          ;;
        add|a)
          shift
          cmd_autodownload_add "$@"
          ;;
        remove|rm|del)
          shift
          cmd_autodownload_remove "$@"
          ;;
        remove-id)
          shift
          cmd_autodownload_remove_id "$@"
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    version)
      shift
      cmd_version "$@"
      ;;
    *)
      printf 'Unknown command: %s\n' "$1" >&2
      usage >&2
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
  main "$@"
fi

